{
  "buildCommand": "cd stockpilot-mern/client && npm install && npm run build",
  "outputDirectory": "stockpilot-mern/client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://stockpilot-ai-ui9o.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
